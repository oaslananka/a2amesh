{
  "name": "@a2amesh/runtime-example-openai-compatible-provider",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Provider-neutral OpenAI-compatible adapter example for A2A Mesh.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "start": "pnpm --dir ../.. run build && node dist/src/index.js",
    "smoke": "pnpm --dir ../.. run build && node --test dist/tests/smoke.test.js",
    "live:smoke": "pnpm --dir ../.. run build && node dist/src/live-smoke.js"
  },
  "dependencies": {
    "@a2amesh/internal-adapter-openai": "workspace:*",
    "@a2amesh/runtime": "workspace:*",
    "openai": "6.44.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.1 <25",
    "pnpm": ">=11 <12"
  }
}
