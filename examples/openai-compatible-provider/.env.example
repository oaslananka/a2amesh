# OpenAI-compatible endpoint settings. Keep real values in your runtime secret manager.
A2AMESH_OPENAI_COMPAT_BASE_URL=https://example.invalid/v1
A2AMESH_OPENAI_COMPAT_API_KEY=replace-with-secret-reference
A2AMESH_OPENAI_COMPAT_MODEL=replace-with-model-id
A2AMESH_OPENAI_COMPAT_PROFILE=custom
A2AMESH_OPENAI_COMPAT_TIMEOUT_MS=30000
A2AMESH_OPENAI_COMPAT_MAX_TOKENS=256
A2AMESH_OPENAI_COMPAT_TEMPERATURE=0.2
A2AMESH_OPENAI_COMPAT_SUPPORTS_STREAMING=unknown
A2AMESH_OPENAI_COMPAT_SUPPORTS_TOOL_CALLING=unknown

# The live command remains disabled unless this is explicitly set to 1.
A2AMESH_OPENAI_COMPAT_LIVE=0
